# Browser-safe Supabase configuration. Never put a database password or secret/service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Explicit device-only demo, even when Supabase credentials are present.
VITE_DEMO_MODE=false

# Optional Firebase AI Logic only. Supabase handles the database and authentication.
# Never add a Gemini API key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
